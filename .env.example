# Garage admin / economics
GARAGE_ADMIN_ADDRESSES=0x...
GARAGE_CAMPAIGN_FEE_BPS=250
GARAGE_X_PAYOUT_DELAY_SECONDS=300
NEXT_PUBLIC_GARAGE_X_DEFAULT_TWEET_URL=

# Circles recipient / payout wallet
SAFE_ADDRESS=0x...
NEXT_PUBLIC_DEFAULT_RECIPIENT_ADDRESS=0x...
BOT_PRIVATE_KEY=
ROLES_MODIFIER_ADDRESS=
ROLE_KEY=
MAX_PAYOUT_CRC=1000

# Optional
