# App
NEXT_PUBLIC_APP_URL=https://crc-boost-market.vercel.app
GARAGE_STANDALONE=true

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# X API / OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://crc-boost-market.vercel.app/api/garage/x/connect/callback
